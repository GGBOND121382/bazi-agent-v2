{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-result-v1",
  "title": "ValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "analysis_id",
    "status",
    "errors",
    "warnings",
    "approved_claim_ids",
    "required_revisions"
  ],
  "properties": {
    "schema_version": {
      "const": "validation-result-v1"
    },
    "validation_id": {
      "type": "string"
    },
    "analysis_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "needs_human_review"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approved_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_revisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
