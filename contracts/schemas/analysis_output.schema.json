{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-output-v1",
  "title": "StructuredAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "chart_id",
    "school",
    "claims",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "analysis-output-v1"},
    "analysis_id": {"type": "string"},
    "chart_id": {"type": "string"},
    "school": {"type": "string"},
    "executive_summary": {"type": ["string", "null"]},
    "reasoning_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "conclusion", "confidence"],
        "properties": {
          "dimension": {"type": "string"},
          "conclusion": {"type": "string"},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "rule_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "counterpoints": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "structure_assessment": {"type": ["object", "null"]},
    "temporal_assessment": {
      "type": "array",
      "items": {"type": "object"}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "topic",
          "statement",
          "fact_ids",
          "rule_ids",
          "evidence_ids",
          "confidence",
          "temporal_scope"
        ],
        "properties": {
          "claim_id": {"type": "string"},
          "topic": {"type": "string"},
          "statement": {"type": "string"},
          "fact_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "rule_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "counterevidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "temporal_scope": {"type": "string"},
          "school": {"type": "string"}
        }
      }
    },
    "reflection": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pass", "revise"]},
        "checked_dimensions": {"type": "array", "items": {"type": "string"}},
        "missing_dimensions": {"type": "array", "items": {"type": "string"}},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "revision_instructions": {"type": "array", "items": {"type": "string"}},
        "coverage_scores": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
